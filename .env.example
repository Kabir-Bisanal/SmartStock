# PostgreSQL is the intended SmartStock data source. Leave blank to use
# the read-only local CSV demo fallback.
DATABASE_URL=

# Supported values: auto, postgres, csv
SMARTSTOCK_DATA_MODE=auto

# Optional Docker Compose settings. These are local development placeholders,
# not production credentials. Put real values in an ignored .env file.
POSTGRES_DB=smartstock
POSTGRES_USER=smartstock
POSTGRES_PASSWORD=change-me-for-local-use
