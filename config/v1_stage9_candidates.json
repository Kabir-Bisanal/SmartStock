  "selection_policy": {
    "validation_only": true,
    "candidate_priority": [
      "fold consistency",
      "30-day recursive daily performance",
      "7-day and 30-day aggregate performance",
      "short-horizon performance",
      "absolute bias"
    ],
    "negligible_primary_mae_change_pct": 0.5,
    "maximum_tuning_configurations": 6
  },
  "forecast_policy": {
    "strategy": "recursive",
    "horizon_days": 30,
    "history": "actual active demand through forecast origin, followed only by prior clipped predictions",
    "non_negative_rule": "forecast = max(raw_forecast, 0)",
    "round_forecasts": false
